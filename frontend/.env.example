# Stripe Checkout (create a key in your Stripe Dashboard; use test keys during development)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CARDNET_PUBLIC_URL=http://localhost:5173

# Public bank transfer instructions shown to shoppers
CARDNET_BANK_NAME=
CARDNET_ACCOUNT_NAME=
CARDNET_ACCOUNT_NUMBER=
CARDNET_ROUTING_NUMBER=
CARDNET_IBAN=

# AI shopping assistant (get a key from your OpenAI account)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Keep writes disabled when deploying on an ephemeral-storage host.
CARDNET_READ_ONLY=false
